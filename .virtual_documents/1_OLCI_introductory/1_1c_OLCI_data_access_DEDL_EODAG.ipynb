























import configparser               # a library that allows us to parse standard configuration files
import IPython                    # a library that helps us display video and HTML content
import os                         # a library that allows us access to basic operating system commands like making directories
import shutil                     # a library that allows us access to basic operating system commands like copy
import zipfile                    # a library that allows us to unzip zip-files.
import destinelab                 # a library for that brokers data access for DestinE Data Lake
from pathlib import Path          # a library that helps construct system path objects
import getpass                    # a library to help us enter passwords
import json                       # a library that helps us make JSON format files
from IPython.display import JSON  # a library that helps us print JSON files nicely
import requests                   # a library that helps us make HTTP web requests
import eumartools                 # a EUMETSAT library that support working with Copernicus Sentinel products
eumartools.platform_checker()





# set defaults and overwrite with frameworks config if it exists
config = configparser.ConfigParser()
config["nbook"] = {"v_wd" : "700", "v_ht" : "450"}
if os.path.exists(os.path.join(os.path.dirname(os.getcwd()),"frameworks","config.ini")):
    config.read(os.path.join(os.path.dirname(os.getcwd()),"frameworks","config.ini"))





# Create a download directory for our OLCI products
download_dir = os.path.join(os.getcwd(), "products")
os.makedirs(download_dir, exist_ok=True)























# load credentials
destine_credentials_file = Path(Path.home() / '.destine' / 'credentials')

if os.path.exists(destine_credentials_file):
    username, password = Path(destine_credentials_file).read_text().split(',')
else:
    # creating authentication file
    username = input('Enter your DestinE DESP username: ')
    password = getpass.getpass('Enter your DestinE DESP password: ')
    try:
        os.makedirs(os.path.dirname(destine_credentials_file), exist_ok=True)
        with open(destine_credentials_file, "w") as f:
            f.write(f'{username},{password}')
    except:
        pass
        
access_token = destinelab.AuthHandler(username, password).get_token()
auth_headers = {"Authorization": f"Bearer {access_token}"}





query_EFR = {
    "collections": ["EO.EUM.DAT.SENTINEL-3.OL_1_EFR___"],
    "datetime": "2021-07-17T10:10:15.000Z/2021-07-17T10:13:14.000Z"}





response = requests.post("https://hda.data.destination-earth.eu/stac/search", headers=auth_headers, json=query_EFR)





JSON(response.json()["features"])





product = response.json()["features"][0]
response = requests.get(product["assets"]["downloadLink"]["href"], headers=auth_headers, stream=True)
with open(product["id"], 'wb') as f:
    for chunk in response.iter_content(chunk_size=1024):
        f.write(chunk)





with zipfile.ZipFile(product["id"], 'r') as zip_ref:
    zip_ref.extractall(download_dir)
    print(f'Unzipping of product {product["id"]} finished.')
os.remove(product["id"])





query_WRR = {
    "collections": ["EO.EUM.DAT.SENTINEL-3.OL_2_WRR___"],
    "datetime": "2021-07-17T10:10:15.000Z/2021-07-17T10:13:14.000Z"}

query_WFR = {
    "collections": ["EO.EUM.DAT.SENTINEL-3.OL_2_WFR___"],
    "datetime": "2021-07-17T10:10:15.000Z/2021-07-17T10:13:14.000Z"}

queries = [query_WRR, query_WFR]





for query in queries:
    response = requests.post("https://hda.data.destination-earth.eu/stac/search", headers=auth_headers, json=query)
    product = response.json()["features"][0]
    response = requests.get(product["assets"]["downloadLink"]["href"], headers=auth_headers, stream=True)
    with open(product["id"], 'wb') as f:
        for chunk in response.iter_content(chunk_size=1024):
            f.write(chunk)
    with zipfile.ZipFile(product["id"], 'r') as zip_ref:
        zip_ref.extractall(download_dir)
        print(f'Unzipping of product {product["id"]} finished.')
    os.remove(product["id"])






